# pi-ai-go examples/agent configuration
#
# 复制此文件为 .env 并填入你的配置。
# 加载顺序（按首个存在的文件）：.env > ../.env > ../../.env

# --- 统一 LLM 配置（推荐） ----------------------------------------
# API Key（必填）
# LLM_API_KEY=sk-xxx

# Provider id (openai, deepseek, anthropic, glm, kimi, ...)。默认 deepseek
# LLM_PROVIDER=deepseek

# 模型 ID
# LLM_MODEL=Qwen/Qwen2.5-7B-Instruct

# Base URL
# LLM_BASE_URL=https://api.siliconflow.cn/v1

# 思维链级别：off | minimal | low | medium | high | xhigh（默认 medium）
# LLM_REASONING=medium

# --- 兼容旧名（不推荐） -------------------------------------------
# XIAOMI_API_KEY=sk-xxx
# XIAOMI_BASE_URL=https://api.siliconflow.cn/v1
# XIAOMI_MODEL=Qwen/Qwen2.5-7B-Instruct
# SILICONFLOW_API_KEY=sk-xxx
# SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
# SILICONFLOW_MODEL=Qwen/Qwen2.5-7B-Instruct
