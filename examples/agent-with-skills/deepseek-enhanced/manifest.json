{
  "manifest_version": 3,
  "name": "DeepSeek Enhanced",
  "version": "0.1.0",
  "description": "拦截请求，注入自定义系统提示词",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["storage", "sidePanel"],
  "host_permissions": ["https://lanz.hikvision.com/*"],
  "background": {
    "service_worker": "background/background.js"
  },
  "side_panel": {
    "default_path": "sidepanel/index.html"
  },
  "content_scripts": [
    {
      "matches": ["https://lanz.hikvision.com/*"],
      "js": ["content/ui-injector.js"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["content/fetch-interceptor.js"],
      "matches": ["https://lanz.hikvision.com/*"]
    }
  ]
}
